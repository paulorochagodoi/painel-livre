<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de destino: casa/trabalho, ou a próxima manobra quando há rota no Maps/Waze. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:tag="card_click">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/destIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_route"
                android:tag="icon_accent" />

            <FrameLayout
                android:id="@+id/destManeuverBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:tag="chip_on"
                android:visibility="gone">

                <br.painellivre.cluster.ManeuverView
                    android:id="@+id/destManeuver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/destTitle"
                style="@style/CcTitle"
                android:text="@string/destination" />

            <TextView
                android:id="@+id/destSub"
                style="@style/CcSub"
                android:text="@string/destination_hint" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/destButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/destHome"
            style="@style/CcChipRow"
            android:layout_marginEnd="10dp">

            <ImageView
                style="@style/CcChipIcon"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/destHomeText"
                style="@style/CcChipText"
                android:text="@string/go_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/destWork"
            style="@style/CcChipRow">

            <ImageView
                style="@style/CcChipIcon"
                android:src="@drawable/ic_work" />

            <TextView
                android:id="@+id/destWorkText"
                style="@style/CcChipText"
                android:text="@string/go_work" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/destOpenApp"
        style="@style/CcChipButton"
        android:layout_width="match_parent"
        android:tag="chip_on"
        android:visibility="gone" />

    <LinearLayout style="@style/CcFooter">

        <ImageView
            style="@style/CcFooterIcon"
            android:src="@drawable/ic_navigation" />

        <TextView
            android:id="@+id/destFooter"
            style="@style/CcFooterText"
            android:text="@string/nav_title" />
    </LinearLayout>
</LinearLayout>
