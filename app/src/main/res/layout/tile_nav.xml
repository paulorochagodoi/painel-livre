<?xml version="1.0" encoding="utf-8"?>
<!-- Atalho Navegação: Casa e Trabalho com a distância, ou a próxima manobra da rota ativa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileNav"
    style="@style/AuTile"
    android:contentDescription="@string/nav_title">

    <LinearLayout style="@style/AuTileHead">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/tileNavBadge"
                style="@style/AuBadge"
                android:src="@drawable/au_nav" />

            <br.painellivre.cluster.ManeuverView
                android:importantForAccessibility="no"
                android:id="@+id/tileNavManeuver"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:tag="a_badge_on"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            style="@style/AuTileTitle"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nav_title" />

        <ImageView android:importantForAccessibility="no" style="@style/AuChevron" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/tileNavFavs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:importantForAccessibility="no"
                style="@style/AuIconSmall"
                android:src="@drawable/au_home" />

            <TextView
                style="@style/AuLabel"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/go_home" />

            <TextView
                android:id="@+id/tileNavHome"
                style="@style/AuCaption"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:importantForAccessibility="no"
                style="@style/AuIconSmall"
                android:src="@drawable/au_work" />

            <TextView
                style="@style/AuLabel"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/go_work" />

            <TextView
                android:id="@+id/tileNavWork"
                style="@style/AuCaption"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tileNavRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tileNavDistance"
            style="@style/AuNumM" />

        <TextView
            android:id="@+id/tileNavSub"
            style="@style/AuCaption"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
