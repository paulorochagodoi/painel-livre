<?xml version="1.0" encoding="utf-8"?>
<!-- NavPanel: rota ativa (com Encerrar/Abrir), campo de busca, Casa e Trabalho e categorias. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popNav"
    android:layout_width="470dp"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout style="@style/AuPopHead">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/AuTitle"
                    android:text="@string/nav_title" />

                <TextView
                    android:id="@+id/popNavApp"
                    style="@style/AuCaption"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/popNavClose"
                style="@style/AuClose" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popNavRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:tag="a_mode_on"
            android:visibility="gone">

            <br.painellivre.cluster.ManeuverView
                android:importantForAccessibility="no"
                android:id="@+id/popNavManeuver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="5dp"
                android:tag="a_badge_on" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/popNavRouteTitle"
                    style="@style/AuBodyStrong" />

                <TextView
                    android:id="@+id/popNavRouteSub"
                    style="@style/AuCaption"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/popNavRouteAction"
                style="@style/AuPillSecondary"
                android:layout_marginStart="8dp"
                android:tag="a_raised_sm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popNavSearch"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:contentDescription="@string/destination_hint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:tag="a_sunken_click">

            <ImageView
                android:importantForAccessibility="no"
                style="@style/AuIcon"
                android:src="@drawable/au_search" />

            <TextView
                style="@style/AuBody"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:tag="a_muted"
                android:text="@string/destination_hint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/popNavHome"
                layout="@layout/pop_nav_fav" />

            <Space android:layout_width="12dp" android:layout_height="0dp" />

            <include
                android:id="@+id/popNavWork"
                layout="@layout/pop_nav_fav" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/popNavCats"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/popCatCharge"
                layout="@layout/aura_cat_charge" />

            <include
                android:id="@+id/popCatFuel"
                layout="@layout/aura_cat_fuel" />

            <include
                android:id="@+id/popCatParking"
                layout="@layout/aura_cat_parking" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
