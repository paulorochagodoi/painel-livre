<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de mídia: o que está tocando em qualquer app, com anterior / tocar / próxima. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardMedia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:tag="card_click">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_music"
            android:tag="icon_accent" />

        <TextView
            style="@style/CcSection"
            android:text="@string/section_media" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mediaArt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_music"
            android:tag="icon_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mediaTitle"
                style="@style/CcTitle"
                android:text="@string/media_choose" />

            <TextView
                android:id="@+id/mediaSub"
                style="@style/CcSub"
                android:text="@string/media_open" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mediaPrev"
            style="@style/CcRoundButton"
            android:contentDescription="@string/media_prev"
            android:src="@drawable/ic_prev" />

        <ImageView
            android:id="@+id/mediaPlay"
            style="@style/CcRoundButton.Big"
            android:contentDescription="@string/media_play"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/mediaNext"
            style="@style/CcRoundButton"
            android:contentDescription="@string/media_next"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</LinearLayout>
