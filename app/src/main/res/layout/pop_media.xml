<?xml version="1.0" encoding="utf-8"?>
<!-- MediaPanel: o que toca agora em qualquer app (sessão de mídia do Android), anterior / tocar-pausar
     / próxima e volume da mídia. Sem rádios nem músicas de exemplo: sem sessão, "Nada tocando". -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popMedia"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout style="@style/AuPopHead">

            <TextView
                style="@style/AuTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/tab_media" />

            <TextView
                android:id="@+id/popMediaOpen"
                style="@style/AuPillSecondary"
                android:layout_marginEnd="12dp"
                android:text="@string/media_open_app" />

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/popMediaClose"
                style="@style/AuClose" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/popMediaArtBox"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:tag="a_soft">

                <br.painellivre.ui.aura.EqualizerView
                    android:id="@+id/popMediaEq"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center" />

                <ImageView
                    android:id="@+id/popMediaArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/popMediaTitle"
                    style="@style/AuTitle"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/popMediaArtist"
                    style="@style/AuBody"
                    android:layout_marginTop="2dp"
                    android:tag="a_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/popMediaSource"
                    style="@style/AuLabel"
                    android:layout_marginTop="10dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:tag="a_soft_pill"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/popMediaPrev"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/media_prev"
                android:padding="20dp"
                android:src="@drawable/au_prev"
                android:tag="a_sunken_round" />

            <ImageView
                android:id="@+id/popMediaPlay"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="@string/media_play"
                android:padding="23dp"
                android:src="@drawable/au_play"
                android:tag="a_primary_round" />

            <ImageView
                android:id="@+id/popMediaNext"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/media_next"
                android:padding="20dp"
                android:src="@drawable/au_next"
                android:tag="a_sunken_round" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/popVolDown"
                style="@style/AuRoundSmall"
                android:contentDescription="@string/volume_down"
                android:src="@drawable/au_minus"
                android:tag="a_sunken_sm" />

            <ProgressBar
                android:id="@+id/popVolBar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:tag="a_bar" />

            <ImageView
                android:id="@+id/popVolUp"
                style="@style/AuRoundSmall"
                android:contentDescription="@string/volume_up"
                android:src="@drawable/au_plus"
                android:tag="a_sunken_sm" />

            <TextView
                android:id="@+id/popVolValue"
                style="@style/AuLabel"
                android:layout_width="28dp"
                android:layout_marginStart="12dp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
