<?xml version="1.0" encoding="utf-8"?>
<!-- Temperatura de um lado (au-tcard): o valor lido, com botões −/+ embaixo, sem lista
     (achado extra do Paulo, teste no carro de 29/10: a lista 16..30° também virou toque direto). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp"
    android:tag="a_sunken">

    <TextView
        android:id="@+id/tempLabel"
        style="@style/AuLabelMuted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tempValue"
        style="@style/AuNumL"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tempDown"
            style="@style/AuRoundSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:contentDescription="@string/temp_down"
            android:src="@drawable/au_minus"
            android:tag="a_sunken_sm" />

        <Space android:layout_width="10dp" android:layout_height="0dp" />

        <ImageView
            android:id="@+id/tempUp"
            style="@style/AuRoundSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:contentDescription="@string/temp_up"
            android:src="@drawable/au_plus"
            android:tag="a_sunken_sm" />
    </LinearLayout>
</LinearLayout>
