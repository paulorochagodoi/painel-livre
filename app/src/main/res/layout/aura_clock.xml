<?xml version="1.0" encoding="utf-8"?>
<!-- Herói, à esquerda: relógio (Sora 72), saudação e data, tempo lá fora (toque abre a previsão). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clockBlock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_marginStart="32dp"
    android:layout_marginTop="18dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/clock"
        style="@style/AuClock" />

    <TextView
        android:id="@+id/date"
        style="@style/AuBody"
        android:layout_marginTop="6dp"
        android:tag="a_muted"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/weatherRow"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/weather_title"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:tag="a_plain_click"
        android:visibility="gone">

        <ImageView
            android:importantForAccessibility="no"
            android:id="@+id/weatherIcon"
            style="@style/AuIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/au_cloud"
            android:tag="a_icon_muted" />

        <TextView
            android:id="@+id/weatherText"
            style="@style/AuBody"
            android:layout_marginStart="6dp"
            android:maxWidth="300dp"
            android:tag="a_muted"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
