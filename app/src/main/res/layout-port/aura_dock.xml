<?xml version="1.0" encoding="utf-8"?>
<!-- Dock em pé: sem as temperaturas (estão no atalho Climatização), o resto igual. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:tag="a_dock">

    <ImageView
        android:id="@+id/dockHome"
        style="@style/AuDockButton"
        android:contentDescription="@string/tab_home"
        android:src="@drawable/au_home" />

    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:tag="a_divider" />

    <include layout="@layout/dock_buttons" />
</LinearLayout>
