<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de baixo: abas no meio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dock"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:tag="dockbar">

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabHome"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_home" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/tab_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabNav"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_navigation" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/nav_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMedia"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_music" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/tab_media" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPhone"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_phone" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/tab_phone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabApps"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_apps" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/apps_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            style="@style/CcTab">

            <ImageView
                style="@style/CcTabIcon"
                android:src="@drawable/ic_settings" />

            <TextView
                style="@style/CcTabText"
                android:text="@string/tab_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
