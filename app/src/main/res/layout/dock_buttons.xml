<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos do meio do dock (56 × 56, ícone de linha; segurar mostra o nome). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockMid"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/dockPanel"
        style="@style/AuDockButton"
        android:contentDescription="@string/cluster_title"
        android:src="@drawable/au_gauge" />

    <FrameLayout
        android:id="@+id/dockNavApp"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/open_maps"
        android:padding="0dp">

        <ImageView
            android:id="@+id/dockNavIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/au_route"
            android:tag="a_icon" />

        <br.painellivre.cluster.ManeuverView
            android:id="@+id/dockNavManeuver"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:id="@+id/dockClimate"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/climate_title"
        android:src="@drawable/au_fan" />

    <ImageView
        android:id="@+id/tabPhone"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/tab_phone"
        android:src="@drawable/au_phone" />

    <ImageView
        android:id="@+id/tabApps"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/apps_title"
        android:src="@drawable/au_apps" />

    <ImageView
        android:id="@+id/tabSettings"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/tab_settings"
        android:src="@drawable/au_settings" />

    <ImageView
        android:id="@+id/dockMedia"
        style="@style/AuDockButton"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/tab_media"
        android:src="@drawable/au_volume" />
</LinearLayout>
