<?xml version="1.0" encoding="utf-8"?>
<!-- BatteryPanel só de leitura: % (anel), autonomia total, elétrica e combustível, estado da carga e
     o que mais o carro informa. Os modos EV/HEV, manter carga, limite, agendamento e V2L do Aura
     mandariam comandos ao carro: ficam de fora (BatteryPanel.md: "não deixe opção que não faz nada"). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popBattery"
    android:layout_width="760dp"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout style="@style/AuPopHead">

            <TextView
                style="@style/AuTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/battery_title" />

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/popBatteryClose"
                style="@style/AuClose" />
        </LinearLayout>

        <TextView
            android:id="@+id/popBatteryEmpty"
            style="@style/AuBody"
            android:maxLines="3"
            android:paddingBottom="12dp"
            android:tag="a_muted"
            android:text="@string/car_data_off"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/popBatteryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp">

                        <br.painellivre.ui.aura.RingView
                            android:id="@+id/popBatteryRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/popBatterySoc"
                                style="@style/AuNumM"
                                android:fontFamily="@font/sora_light" />

                            <TextView
                                style="@style/AuLabelMuted"
                                android:text="@string/battery_word"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AuLabelMuted"
                            android:text="@string/range_total"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/popBatteryTotal"
                            style="@style/AuNumM"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:importantForAccessibility="no"
                                android:id="@+id/popBatteryChargeIcon"
                                style="@style/AuIconSmall"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="1dp"
                                android:src="@drawable/au_plug" />

                            <TextView
                                android:id="@+id/popBatteryCharge"
                                style="@style/AuLabel"
                                android:layout_marginStart="6dp"
                                android:maxLines="3"
                                android:tag="a_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/popBatteryEv"
                        layout="@layout/pop_stat" />

                    <Space android:layout_width="8dp" android:layout_height="0dp" />

                    <include
                        android:id="@+id/popBatteryFuel"
                        layout="@layout/pop_stat" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/popBatteryRows"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AuCaption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/battery_readonly" />

            <TextView
                android:id="@+id/popBatteryMore"
                style="@style/AuPillSecondary"
                android:layout_marginStart="12dp"
                android:text="@string/car_data_all" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
