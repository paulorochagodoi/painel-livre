<?xml version="1.0" encoding="utf-8"?>
<!-- ClimatePanel só de leitura: temperatura de cada lado, ventilação, modos e bancos como o carro
     informa. Nenhum botão muda o carro (sem −/+, sem liga/desliga): só mostra. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popClimate"
    android:layout_width="700dp"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout style="@style/AuPopHead">

            <TextView
                style="@style/AuTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/climate_title" />

            <TextView
                android:id="@+id/popClimateState"
                style="@style/AuLabel"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:tag="a_sunken_pill"
                android:text="@string/read_only" />

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/popClimateClose"
                style="@style/AuClose" />
        </LinearLayout>

        <TextView
            android:id="@+id/popClimateEmpty"
            style="@style/AuBody"
            android:maxLines="3"
            android:paddingBottom="12dp"
            android:tag="a_muted"
            android:text="@string/car_data_off"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/popClimateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/popClimateDriver"
                        layout="@layout/pop_temp" />

                    <Space android:layout_width="12dp" android:layout_height="0dp" />

                    <include
                        android:id="@+id/popClimatePassenger"
                        layout="@layout/pop_temp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/popClimateFanLabel"
                    style="@style/AuLabelMuted"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <br.painellivre.ui.aura.LevelBars
                    android:id="@+id/popClimateFan"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <TextView
                    android:id="@+id/popClimateAir"
                    style="@style/AuCaption"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/popClimateModes"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/modeAuto"
                        layout="@layout/pop_mode" />

                    <include
                        android:id="@+id/modeAc"
                        layout="@layout/pop_mode" />

                    <include
                        android:id="@+id/modeRecirc"
                        layout="@layout/pop_mode" />

                    <include
                        android:id="@+id/modeDefrost"
                        layout="@layout/pop_mode" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/popClimateSeats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/seatDriver"
                        layout="@layout/pop_seat" />

                    <Space android:layout_width="12dp" android:layout_height="0dp" />

                    <include
                        android:id="@+id/seatPassenger"
                        layout="@layout/pop_seat" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/AuCaption"
            android:layout_marginTop="16dp"
            android:text="@string/climate_readonly" />
    </LinearLayout>
</ScrollView>
