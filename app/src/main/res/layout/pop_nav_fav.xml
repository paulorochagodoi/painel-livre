<?xml version="1.0" encoding="utf-8"?>
<!-- Casa ou Trabalho na janela de navegação: toque vai, segurar redefine. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="14dp"
    android:tag="a_sunken_click">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/favIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/au_home"
            android:tag="a_badge_on" />

        <TextView
            android:id="@+id/favDistance"
            style="@style/AuNumS"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/favName"
        style="@style/AuBodyStrong"
        android:layout_marginTop="10dp"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/favSub"
        style="@style/AuCaption"
        android:maxLines="1" />
</LinearLayout>
