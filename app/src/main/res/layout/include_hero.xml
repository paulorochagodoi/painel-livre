<?xml version="1.0" encoding="utf-8"?>
<!-- Área do carro: ilustração (ou foto do motorista), autonomia à esquerda, tempo à direita e,
     quando falta configurar algo, um aviso em cima. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ImageView
        android:id="@+id/carArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/car_title"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/rangeBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="36dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rangeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:tag="t1"
                android:text="—"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:tag="t2"
                android:text="km"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rangeSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:tag="t2"
            android:textAllCaps="true"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/rangeBar"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="220dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:tag="progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weatherCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="18dp"
        android:gravity="end"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:tag="card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-light"
                android:tag="t1"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/weatherDesc"
            style="@style/CcSub" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setupCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:tag="card"
        android:visibility="gone">

        <TextView
            android:id="@+id/setupText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:tag="t1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/setupButton"
            style="@style/CcChipButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:tag="chip_on"
            android:text="@string/setup_now" />
    </LinearLayout>
</FrameLayout>
