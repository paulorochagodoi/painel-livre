<?xml version="1.0" encoding="utf-8"?>
<!-- Lado esquerdo da aba Navegação: busca, escolha Google Maps/Waze, rota atual e lugares. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navSide"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:tag="card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp"
        android:tag="capsule">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            android:tag="icon2" />

        <EditText
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:tag="t1"
            android:textSize="19sp" />

        <ImageView
            android:id="@+id/navClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/clear"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tag="icon2"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/navPickBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="6dp"
        android:tag="accent"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/appMaps"
            style="@style/CcSegment"
            android:layout_marginEnd="10dp"
            android:text="@string/open_maps" />

        <TextView
            android:id="@+id/appWaze"
            style="@style/CcSegment"
            android:text="@string/open_waze" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:tag="chip"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="7dp"
            android:tag="chip_on">

            <br.painellivre.cluster.ManeuverView
                android:id="@+id/navActiveManeuver"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navActiveDistance"
                style="@style/CcTitle"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/navActiveStreet"
                style="@style/CcSub" />

            <TextView
                android:id="@+id/navActiveEta"
                style="@style/CcSub"
                android:tag="accent" />
        </LinearLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:tag="icon2" />
    </LinearLayout>

    <TextView
        android:id="@+id/navListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.08"
        android:tag="t2"
        android:text="@string/places"
        android:textAllCaps="true"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/navList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
