<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de configuração em pé: abaixo do relógio, acima do carro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupCard"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginTop="196dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="6dp"
    android:tag="a_banner"
    android:visibility="gone">

    <ImageView
        android:importantForAccessibility="no"
        style="@style/AuIconSmall"
        android:src="@drawable/au_alert"
        android:tag="a_icon_warn" />

    <TextView
        android:id="@+id/setupText"
        style="@style/AuLabel"
        android:layout_marginStart="8dp"
        android:maxWidth="480dp"
        android:tag="a_warn" />

    <TextView
        android:id="@+id/setupButton"
        style="@style/AuPillButton"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/setup_now"
        android:textSize="15sp" />
</LinearLayout>
